# A cross-realm panic in the swap callback aborts the production transaction.
# The optimistic output transfer and global pool lock must both roll back.

loadpkg gno.land/p/nt/bptree/v0
loadpkg gno.land/p/nt/ufmt/v0
loadpkg gno.land/p/onbloc/json/v0
loadpkg gno.land/p/nt/ownable/v0
loadpkg gno.land/p/nt/grc20/v0
loadpkg gno.land/p/nt/grc721/v0
loadpkg gno.land/r/demo/defi/foo20

loadpkg gno.land/r/sys/users
loadpkg gno.land/r/gnoland/wugnot
loadpkg gno.land/r/nt/grc20reg/v0

loadpkg gno.land/r/gnoswap/access/v1
loadpkg gno.land/p/gnoswap/uint256/v1
loadpkg gno.land/p/gnoswap/gnsmath/v1
loadpkg gno.land/p/gnoswap/store/v1
loadpkg gno.land/p/gnoswap/version_manager/v1

loadpkg gno.land/r/gnoswap/rbac/v1
loadpkg gno.land/r/gnoswap/halt/v1
loadpkg gno.land/r/gnoswap/common
loadpkg gno.land/r/gnoswap/common/v1
loadpkg gno.land/r/gnoswap/referral/v1

loadpkg gno.land/r/gnoswap/gns
loadpkg gno.land/r/gnoswap/gnft
loadpkg gno.land/r/gnoswap/gov/xgns
loadpkg gno.land/r/gnoswap/emission
loadpkg gno.land/r/gnoswap/protocol_fee

loadpkg gno.land/r/gnoswap/pool
loadpkg gno.land/r/gnoswap/position

loadpkg gno.land/r/gnoswap/protocol_fee/v1
loadpkg gno.land/r/gnoswap/pool/v1
loadpkg gno.land/r/gnoswap/position/v1

adduser test_admin
patchpkg "g1lmvrrrr4er2us84h2732sru76c9zl2nvknha8c" $test_admin_user_addr

adduser user1
patchpkg "g16a7etgm9z2r653ucl36rj0l2yqcxgrz2jyegzx" $test1_user_addr

gnoland start

gnokey maketx addpkg -pkgdir $WORK/swap_wrapper -pkgpath gno.land/r/swap_wrapper -gas-fee 100000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'

gnokey maketx send -send 10000000000ugnot -to $test1_user_addr -broadcast -chainid=tendermint_test -gas-fee 100000000ugnot -gas-wanted 100000000 test1
stdout 'OK!'

gnokey maketx send -send 100000000ugnot -to $test_admin_user_addr -insecure-password-stdin=true -broadcast=true -chainid=tendermint_test -gas-fee 100000000ugnot -gas-wanted 100000000 -memo "" test1
stdout 'OK!'

gnokey maketx send -send 500000000ugnot -to $test1_user_addr -insecure-password-stdin=true -broadcast=true -chainid=tendermint_test -gas-fee 100000000ugnot -gas-wanted 100000000 -memo "" test1
stdout 'OK!'

gnokey maketx send -send 500000000ugnot -to $test_admin_user_addr -insecure-password-stdin=true -broadcast=true -chainid=tendermint_test -gas-fee 100000000ugnot -gas-wanted 100000000 -memo "" test1
stdout 'OK!'

gnokey maketx call -pkgpath gno.land/r/gnoswap/gns -func Approve -args g1dexaf6aqkkyr9yfy9d5up69lsn7ra80af34g5v -args 9223372036854775806 -insecure-password-stdin=true -broadcast=true -chainid=tendermint_test -gas-fee 100000000ugnot -gas-wanted 1000000000 -memo "" test1
stdout 'OK!'

gnokey maketx call -pkgpath gno.land/r/gnoswap/pool -func CreatePool -args "gno.land/r/gnoland/wugnot.wugnot" -args "gno.land/r/gnoswap/gns.GNS" -args 3000 -args 79228162514264337593543950337 -gas-fee 10000000ugnot -gas-wanted 1000000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'

gnokey maketx call -pkgpath gno.land/r/gnoland/wugnot -func Deposit -send "100000000ugnot" -insecure-password-stdin=true -broadcast=true -chainid=tendermint_test -gas-fee 100000000ugnot -gas-wanted 1000000000 -memo "" test1
stdout 'OK!'

gnokey maketx call -pkgpath gno.land/r/gnoswap/gns -func Approve -args g1dexaf6aqkkyr9yfy9d5up69lsn7ra80af34g5v -args 9223372036854775806 -insecure-password-stdin=true -broadcast=true -chainid=tendermint_test -gas-fee 100000000ugnot -gas-wanted 1000000000 -memo "" test1
stdout 'OK!'

gnokey maketx call -pkgpath gno.land/r/gnoland/wugnot -func Approve -args g1dexaf6aqkkyr9yfy9d5up69lsn7ra80af34g5v -args 9223372036854775806 -insecure-password-stdin=true -broadcast=true -chainid=tendermint_test -gas-fee 100000000ugnot -gas-wanted 1000000000 -memo "" test1
stdout 'OK!'

gnokey maketx call -pkgpath gno.land/r/gnoland/wugnot -func Approve -args g1y3uyaa63sjxvah2cx3c2usavwvx97kl8m2v7ye -args 9223372036854775806 -insecure-password-stdin=true -broadcast=true -chainid=tendermint_test -gas-fee 100000000ugnot -gas-wanted 1000000000 -memo "" test1
stdout 'OK!'

gnokey maketx call -pkgpath gno.land/r/gnoswap/position -func Mint -args gno.land/r/gnoswap/gns.GNS -args "gno.land/r/gnoland/wugnot.wugnot" -args 3000 -args "-887220" -args "887220" -args 50000000 -args 50000000 -args 1 -args 1 -args 9999999999 -args $test1_user_addr -args "" -insecure-password-stdin=true -broadcast=true -chainid=tendermint_test -gas-fee 100000000ugnot -gas-wanted 1000000000 -memo "" test1
stdout 'OK!'

gnokey maketx call -pkgpath gno.land/r/gnoswap/gns -func Approve -args g1xt9lk80qqng30ahnk9axg2f2m4xdlp375w2x90 -args 9223372036854775806 -insecure-password-stdin=true -broadcast=true -chainid=tendermint_test -gas-fee 100000000ugnot -gas-wanted 1000000000 -memo "" test1
stdout 'OK!'

# Snapshot recipient and pool token balances before the malicious callback.
gnokey maketx call -pkgpath gno.land/r/swap_wrapper -func SnapshotBalances -args "gno.land/r/gnoland/wugnot.wugnot" -args "gno.land/r/gnoswap/gns.GNS" -args $test1_user_addr -gas-fee 100000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'

# Swap transfers WUGNOT output before invoking this callback. The callback panic
# crosses a realm boundary and fails the transaction without using revive().
! gnokey maketx run test1 $WORK/run/panicking_swap.gno -gas-fee 100000000ugnot -gas-wanted 1000000000 -broadcast -chainid=tendermint_test
stderr 'panicking swap callback'

# The failed transaction discards both sides of the optimistic token transfer.
gnokey maketx call -pkgpath gno.land/r/swap_wrapper -func AssertBalancesUnchanged -args "gno.land/r/gnoland/wugnot.wugnot" -args "gno.land/r/gnoswap/gns.GNS" -args $test1_user_addr -gas-fee 100000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'

# A normal swap succeeds afterward, proving the pool accounting and global lock
# writes also rolled back with the failed transaction.
gnokey maketx run test1 $WORK/run/paying_swap.gno -gas-fee 100000000ugnot -gas-wanted 1000000000 -broadcast -chainid=tendermint_test
stdout 'OK!'
stdout '-27293886'
stdout '60283363'

-- swap_wrapper/gnomod.toml --
module = "gno.land/r/swap_wrapper"
gno = "0.9"
-- swap_wrapper/callback.gno --
package swap_wrapper

import (
	"chain"
	"chain/runtime/unsafe"
	"errors"

	"gno.land/r/gnoswap/common"
	"gno.land/r/gnoswap/pool"
)

var poolAddr = chain.PackageAddress("gno.land/r/gnoswap/pool")

var (
	snapshotUserToken0 int64
	snapshotUserToken1 int64
	snapshotPoolToken0 int64
	snapshotPoolToken1 int64
)

func SnapshotBalances(cur realm, token0Path, token1Path string, user address) {
	snapshotUserToken0 = common.BalanceOf(token0Path, user)
	snapshotUserToken1 = common.BalanceOf(token1Path, user)
	snapshotPoolToken0 = common.BalanceOf(token0Path, poolAddr)
	snapshotPoolToken1 = common.BalanceOf(token1Path, poolAddr)
}

func AssertBalancesUnchanged(cur realm, token0Path, token1Path string, user address) {
	if common.BalanceOf(token0Path, user) != snapshotUserToken0 ||
		common.BalanceOf(token1Path, user) != snapshotUserToken1 ||
		common.BalanceOf(token0Path, poolAddr) != snapshotPoolToken0 ||
		common.BalanceOf(token1Path, poolAddr) != snapshotPoolToken1 {
		panic("token balances changed after failed swap")
	}
}

func PreparePanickingCallback(
	cur realm,
) func(cur realm, amount0Delta, amount1Delta int64, _ *pool.CallbackMarker) error {
	return func(cur realm, amount0Delta, amount1Delta int64, _ *pool.CallbackMarker) error {
		panic("panicking swap callback")
	}
}

func PreparePayingCallback(
	cur realm,
	token0Path string,
	token1Path string,
	payer address,
) func(cur realm, amount0Delta, amount1Delta int64, _ *pool.CallbackMarker) error {
	return func(cur realm, amount0Delta, amount1Delta int64, _ *pool.CallbackMarker) error {
		if unsafe.PreviousRealm().Address() != poolAddr {
			return errors.New("unauthorized caller")
		}

		switch {
		case amount0Delta > 0:
			common.SafeGRC20TransferFrom(0, cur, token0Path, payer, poolAddr, amount0Delta)
		case amount1Delta > 0:
			common.SafeGRC20TransferFrom(0, cur, token1Path, payer, poolAddr, amount1Delta)
		}

		return nil
	}
}

-- run/panicking_swap.gno --
package main

import (
	"chain/runtime/unsafe"

	"gno.land/r/gnoswap/pool"
	"gno.land/r/swap_wrapper"
)

func main(cur realm) {
	callbackFn := swap_wrapper.PreparePanickingCallback(cross(cur))

	pool.Swap(
		cross(cur),
		"gno.land/r/gnoland/wugnot.wugnot",
		"gno.land/r/gnoswap/gns.GNS",
		3000,
		unsafe.PreviousRealm().Address(),
		false,
		"60283363",
		"1461446703485210103287273052203988822378723970341",
		callbackFn,
	)
}

-- run/paying_swap.gno --
package main

import (
	"chain/runtime/unsafe"

	"gno.land/r/gnoswap/pool"
	"gno.land/r/swap_wrapper"
)

func main(cur realm) {
	token0Path := "gno.land/r/gnoland/wugnot.wugnot"
	token1Path := "gno.land/r/gnoswap/gns.GNS"
	userAddr := unsafe.PreviousRealm().Address()
	callbackFn := swap_wrapper.PreparePayingCallback(cross(cur), token0Path, token1Path, userAddr)

	amount0, amount1 := pool.Swap(
		cross(cur),
		token0Path,
		token1Path,
		3000,
		userAddr,
		false,
		"60283363",
		"1461446703485210103287273052203988822378723970341",
		callbackFn,
	)
	println(amount0)
	println(amount1)
}
