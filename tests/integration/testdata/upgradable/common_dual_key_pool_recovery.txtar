# Regression for the dual-key case at the pool level.
#
# A pool is created with a v0 token (DUAL) while only grc20reg/v0 knows the key.
# The issuer then registers a v1 token under the same key. Because common/v2
# gives v0 priority, the existing pool keeps operating on the v0 ledger: swaps
# still settle on v0 and the LP can withdraw its full liquidity. The v1 ledger
# is never touched by the pool.

loadpkg gno.land/p/nt/bptree/v0
loadpkg gno.land/p/nt/ufmt/v0
loadpkg gno.land/p/onbloc/json/v0
loadpkg gno.land/p/nt/ownable/v0
loadpkg gno.land/p/nt/grc20/v0

loadpkg gno.land/r/sys/users
loadpkg gno.land/r/nt/grc20reg/v0

loadpkg gno.land/p/gnoswap/uint256/v1
loadpkg gno.land/p/gnoswap/int256/v1
loadpkg gno.land/p/gnoswap/consts/v1
loadpkg gno.land/p/gnoswap/gnsmath/v1
loadpkg gno.land/p/gnoswap/store/v1
loadpkg gno.land/p/gnoswap/version_manager/v1
loadpkg gno.land/p/gnoswap/utils/v1

loadpkg gno.land/r/gnoswap/access/v1
loadpkg gno.land/r/gnoswap/rbac/v1
loadpkg gno.land/r/gnoswap/common
loadpkg gno.land/r/gnoswap/common/v1

loadpkg gno.land/p/nt/grc721/v0
loadpkg gno.land/r/gnoland/wugnot
loadpkg gno.land/r/gnoswap/halt
loadpkg gno.land/r/gnoswap/referral
loadpkg gno.land/r/gnoswap/gns
loadpkg gno.land/r/gnoswap/gnft
loadpkg gno.land/r/gnoswap/gov/xgns
loadpkg gno.land/r/gnoswap/emission
loadpkg gno.land/r/gnoswap/protocol_fee
loadpkg gno.land/r/gnoswap/pool
loadpkg gno.land/r/gnoswap/position
loadpkg gno.land/r/gnoswap/router
loadpkg gno.land/r/gnoswap/staker

loadpkg gno.land/r/gnoswap/protocol_fee/v1
loadpkg gno.land/r/gnoswap/pool/v1
loadpkg gno.land/r/gnoswap/position/v1
loadpkg gno.land/r/gnoswap/router/v1
loadpkg gno.land/r/gnoswap/staker/v1

gnoland start

gnokey maketx send -send 15000000000ugnot -to $test1_user_addr -broadcast -chainid=tendermint_test -gas-fee 100000000ugnot -gas-wanted 100000000 test1

## Deploy the second GRC20 generation (mock) and the calling realm
gnokey maketx addpkg -pkgdir $WORK/grc20_v1 -pkgpath gno.land/p/nt/grc20/v1 -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
gnokey maketx addpkg -pkgdir $WORK/grc20reg_v1 -pkgpath gno.land/r/nt/grc20reg/v1 -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
gnokey maketx addpkg -pkgdir $WORK/common_caller -pkgpath gno.land/r/test/common_caller -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1

gnokey maketx addpkg -pkgdir $WORK/token_v0 -pkgpath gno.land/r/test/token_v0 -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout 'EVENTS:     \[\{\"type\":\"NewToken\",\"attrs\":\[\{\"key\":\"token\",\"value\":\"gno\.land/r/test/token_v0\.TKV0\.0000000\"\},\{\"key\":\"name\",\"value\":\"TokenV0\"\},\{\"key\":\"symbol\",\"value\":\"TKV0\"\},\{\"key\":\"decimals\",\"value\":\"6\"\}\],\"pkg_path\":\"gno\.land/p/nt/grc20/v0\"\},\{\"type\":\"Transfer\",\"attrs\":\[\{\"key\":\"token\",\"value\":\"gno\.land/r/test/token_v0\.TKV0\.0000000\"\},\{\"key\":\"from\",\"value\":\"\"\},\{\"key\":\"to\",\"value\":\"g1u97mvf4yjxf5anvum8pfzp9w3aa3c7upyfta2r\"\},\{\"key\":\"value\",\"value\":\"1000000\"\}\],\"pkg_path\":\"gno\.land/p/nt/grc20/v0\"\},\{\"type\":\"Transfer\",\"attrs\":\[\{\"key\":\"token\",\"value\":\"gno\.land/r/test/token_v0\.TKV0\.0000000\"\},\{\"key\":\"from\",\"value\":\"\"\},\{\"key\":\"to\",\"value\":\"g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5\"\},\{\"key\":\"value\",\"value\":\"1000000000\"\}\],\"pkg_path\":\"gno\.land/p/nt/grc20/v0\"\},\{\"type\":\"register\",\"attrs\":\[\{\"key\":\"token_path\",\"value\":\"gno\.land/r/test/token_v0\.TKV0\"\},\{\"key\":\"pkgpath\",\"value\":\"gno\.land/r/test/token_v0\"\},\{\"key\":\"slug\",\"value\":\"\"\},\{\"key\":\"symbol\",\"value\":\"TKV0\"\}\],\"pkg_path\":\"gno\.land/r/nt/grc20reg/v0\"\}'
gnokey maketx addpkg -pkgdir $WORK/token_dual_v0first -pkgpath gno.land/r/test/token_dual_v0first -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout 'EVENTS:     \[\{\"type\":\"NewToken\",\"attrs\":\[\{\"key\":\"token\",\"value\":\"gno\.land/r/test/token_dual_v0first\.DUAL\.0000000\"\},\{\"key\":\"name\",\"value\":\"Dual\"\},\{\"key\":\"symbol\",\"value\":\"DUAL\"\},\{\"key\":\"decimals\",\"value\":\"6\"\}\],\"pkg_path\":\"gno\.land/p/nt/grc20/v0\"\},\{\"type\":\"Transfer\",\"attrs\":\[\{\"key\":\"token\",\"value\":\"gno\.land/r/test/token_dual_v0first\.DUAL\.0000000\"\},\{\"key\":\"from\",\"value\":\"\"\},\{\"key\":\"to\",\"value\":\"g1u97mvf4yjxf5anvum8pfzp9w3aa3c7upyfta2r\"\},\{\"key\":\"value\",\"value\":\"1000000\"\}\],\"pkg_path\":\"gno\.land/p/nt/grc20/v0\"\},\{\"type\":\"Transfer\",\"attrs\":\[\{\"key\":\"token\",\"value\":\"gno\.land/r/test/token_dual_v0first\.DUAL\.0000000\"\},\{\"key\":\"from\",\"value\":\"\"\},\{\"key\":\"to\",\"value\":\"g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5\"\},\{\"key\":\"value\",\"value\":\"1000000000\"\}\],\"pkg_path\":\"gno\.land/p/nt/grc20/v0\"\},\{\"type\":\"register\",\"attrs\":\[\{\"key\":\"token_path\",\"value\":\"gno\.land/r/test/token_dual_v0first\.DUAL\"\},\{\"key\":\"pkgpath\",\"value\":\"gno\.land/r/test/token_dual_v0first\"\},\{\"key\":\"slug\",\"value\":\"\"\},\{\"key\":\"symbol\",\"value\":\"DUAL\"\}\],\"pkg_path\":\"gno\.land/r/nt/grc20reg/v0\"\}'
## Register and activate common/v2 (v0 has priority over v1)
gnokey maketx addpkg -pkgdir $WORK/common_v2 -pkgpath gno.land/r/gnoswap/common/v2 -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout 'EVENTS:     \[\{\"type\":\"RegisterInitializer\",\"attrs\":\[\{\"key\":\"domainPath\",\"value\":\"gno\.land/r/gnoswap/common\"\},\{\"key\":\"registeredPackagePath\",\"value\":\"gno\.land/r/gnoswap/common/v2\"\}\],\"pkg_path\":\"gno\.land/p/gnoswap/version_manager/v1\"\}'
gnokey maketx call -pkgpath gno.land/r/gnoswap/common -func UpgradeImpl -args "gno.land/r/gnoswap/common/v2" -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'
stdout 'EVENTS:     \[\{\"type\":\"ChangeImplementation\",\"attrs\":\[\{\"key\":\"domainPath\",\"value\":\"gno\.land/r/gnoswap/common\"\},\{\"key\":\"previousPackagePath\",\"value\":\"gno\.land/r/gnoswap/common/v1\"\},\{\"key\":\"newPackagePath\",\"value\":\"gno\.land/r/gnoswap/common/v2\"\}\],\"pkg_path\":\"gno\.land/p/gnoswap/version_manager/v1\"\}'
gnokey query vm/qeval --data "gno.land/r/gnoswap/common.GetImplementationPackagePath()"
stdout '\(\"gno.land/r/gnoswap/common/v2\" string\)'


## Pool setup: fee 0, approvals for pool/position/router
gnokey maketx call -pkgpath gno.land/r/gnoswap/pool -func SetPoolCreationFee -args 0 -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'
gnokey maketx call -pkgpath gno.land/r/test/token_v0 -func Approve -args "g1dexaf6aqkkyr9yfy9d5up69lsn7ra80af34g5v" -args 9223372036854775806 -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'
gnokey maketx call -pkgpath gno.land/r/test/token_dual_v0first -func ApproveV0 -args "g1dexaf6aqkkyr9yfy9d5up69lsn7ra80af34g5v" -args 9223372036854775806 -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'
gnokey maketx call -pkgpath gno.land/r/test/token_v0 -func Approve -args "g1y3uyaa63sjxvah2cx3c2usavwvx97kl8m2v7ye" -args 9223372036854775806 -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'
gnokey maketx call -pkgpath gno.land/r/test/token_dual_v0first -func ApproveV0 -args "g1y3uyaa63sjxvah2cx3c2usavwvx97kl8m2v7ye" -args 9223372036854775806 -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'
gnokey maketx call -pkgpath gno.land/r/test/token_v0 -func Approve -args "g1vc883gshu5z7ytk5cdynhc8c2dh67pdp4cszkp" -args 9223372036854775806 -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'
gnokey maketx call -pkgpath gno.land/r/test/token_dual_v0first -func ApproveV0 -args "g1vc883gshu5z7ytk5cdynhc8c2dh67pdp4cszkp" -args 9223372036854775806 -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'

gnokey maketx call -pkgpath gno.land/r/gnoswap/pool -func CreatePool -args "gno.land/r/test/token_dual_v0first.DUAL" -args "gno.land/r/test/token_v0.TKV0" -args 3000 -args 79228162514264337593543950336 -gas-fee 100000000ugnot -gas-wanted 1000000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'
stdout 'EVENTS:     .*\{\"type\":\"CreatePool\",\"attrs\":\[.*\{\"key\":\"poolPath\",\"value\":\"gno\.land/r/test/token_dual_v0first\.DUAL:gno\.land/r/test/token_v0\.TKV0:3000\"\}.*\{\"key\":\"tick\",\"value\":\"0\"\}.*\],\"pkg_path\":\"gno\.land/r/gnoswap/pool/v1\"\}'
gnokey maketx call -pkgpath gno.land/r/gnoswap/position -func Mint -args "gno.land/r/test/token_dual_v0first.DUAL" -args "gno.land/r/test/token_v0.TKV0" -args 3000 -args -887220 -args 887220 -args 1000000 -args 1000000 -args 0 -args 0 -args 9999999999 -args $test1_user_addr -args "" -gas-fee 100000000ugnot -gas-wanted 1000000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'
stdout '\(1 uint64\)'
stdout '\(\"1000000\" string\)'
stdout 'EVENTS:     .*\{\"type\":\"Transfer\",\"attrs\":\[\{\"key\":\"token\",\"value\":\"gno\.land/r/test/token_dual_v0first\.DUAL\.0000000\"\},\{\"key\":\"from\",\"value\":\"g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5\"\},\{\"key\":\"to\",\"value\":\"g1dexaf6aqkkyr9yfy9d5up69lsn7ra80af34g5v\"\},\{\"key\":\"value\",\"value\":\"1000000\"\}\],\"pkg_path\":\"gno\.land/p/nt/grc20/v0\"\}.*\{\"type\":\"Transfer\",\"attrs\":\[\{\"key\":\"token\",\"value\":\"gno\.land/r/test/token_v0\.TKV0\.0000000\"\},\{\"key\":\"from\",\"value\":\"g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5\"\},\{\"key\":\"to\",\"value\":\"g1dexaf6aqkkyr9yfy9d5up69lsn7ra80af34g5v\"\},\{\"key\":\"value\",\"value\":\"1000000\"\}\],\"pkg_path\":\"gno\.land/p/nt/grc20/v0\"\}.*\{\"type\":\"Mint\",\"attrs\":\[.*\{\"key\":\"lpPositionId\",\"value\":\"1\"\}.*\{\"key\":\"liquidityDelta\",\"value\":\"1000000\"\}.*\{\"key\":\"amount0\",\"value\":\"1000000\"\}.*\{\"key\":\"amount1\",\"value\":\"1000000\"\}.*\],\"pkg_path\":\"gno\.land/r/gnoswap/position/v1\"\}'
gnokey query vm/qeval --data "gno.land/r/test/token_dual_v0first.BalanceOfV0(\"g1dexaf6aqkkyr9yfy9d5up69lsn7ra80af34g5v\")"
stdout '\(1000000 int64\)'
gnokey query vm/qeval --data "gno.land/r/gnoswap/common.BalanceOf(\"gno.land/r/test/token_dual_v0first.DUAL\", \"g1dexaf6aqkkyr9yfy9d5up69lsn7ra80af34g5v\")"
stdout '\(1000000 int64\)'

## Issuer registers a v1 token under the same key AFTER the pool exists
gnokey maketx call -pkgpath gno.land/r/test/token_dual_v0first -func RegisterV1  -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'
stdout 'EVENTS:     \[\{\"type\":\"NewToken\",\"attrs\":\[\{\"key\":\"token\",\"value\":\"gno\.land/r/test/token_dual_v0first\.DUAL\.v1\"\},\{\"key\":\"name\",\"value\":\"Dual\"\},\{\"key\":\"symbol\",\"value\":\"DUAL\"\},\{\"key\":\"decimals\",\"value\":\"6\"\}\],\"pkg_path\":\"gno\.land/p/nt/grc20/v1\"\},\{\"type\":\"Transfer\",\"attrs\":\[\{\"key\":\"token\",\"value\":\"gno\.land/r/test/token_dual_v0first\.DUAL\.v1\"\},\{\"key\":\"from\",\"value\":\"\"\},\{\"key\":\"to\",\"value\":\"g1u97mvf4yjxf5anvum8pfzp9w3aa3c7upyfta2r\"\},\{\"key\":\"value\",\"value\":\"1000000\"\}\],\"pkg_path\":\"gno\.land/p/nt/grc20/v1\"\},\{\"type\":\"register\",\"attrs\":\[\{\"key\":\"token_path\",\"value\":\"gno\.land/r/test/token_dual_v0first\.DUAL\"\},\{\"key\":\"pkgpath\",\"value\":\"gno\.land/r/test/token_dual_v0first\"\},\{\"key\":\"symbol\",\"value\":\"DUAL\"\}\],\"pkg_path\":\"gno\.land/r/nt/grc20reg/v1\"\}'
gnokey query vm/qeval --data "gno.land/r/test/common_caller.IsRegistered(\"gno.land/r/test/token_dual_v0first.DUAL\")"
stdout '\(true bool\)'
gnokey query vm/qeval --data "gno.land/r/gnoswap/common.BalanceOf(\"gno.land/r/test/token_dual_v0first.DUAL\", \"g1dexaf6aqkkyr9yfy9d5up69lsn7ra80af34g5v\")"
stdout '\(1000000 int64\)'
gnokey query vm/qeval --data "gno.land/r/test/token_dual_v0first.BalanceOfV1(\"g1dexaf6aqkkyr9yfy9d5up69lsn7ra80af34g5v\")"
stdout '\(0 int64\)'

## Swap through the router still settles on the v0 ledger
gnokey maketx call -pkgpath gno.land/r/gnoswap/router -func ExactInSwapRoute -args "gno.land/r/test/token_v0.TKV0" -args "gno.land/r/test/token_dual_v0first.DUAL" -args 10000 -args "gno.land/r/test/token_v0.TKV0:gno.land/r/test/token_dual_v0first.DUAL:3000" -args 100 -args 0 -args 9999999999 -args "" -gas-fee 100000000ugnot -gas-wanted 1000000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'
stdout '\(\"10000\" string\)'
stdout '\(\"9857\" string\)'
stdout 'EVENTS:     .*\{\"type\":\"Transfer\",\"attrs\":\[\{\"key\":\"token\",\"value\":\"gno\.land/r/test/token_dual_v0first\.DUAL\.0000000\"\},\{\"key\":\"from\",\"value\":\"g1dexaf6aqkkyr9yfy9d5up69lsn7ra80af34g5v\"\},\{\"key\":\"to\",\"value\":\"g1vc883gshu5z7ytk5cdynhc8c2dh67pdp4cszkp\"\},\{\"key\":\"value\",\"value\":\"9871\"\}\],\"pkg_path\":\"gno\.land/p/nt/grc20/v0\"\}.*\{\"type\":\"Transfer\",\"attrs\":\[\{\"key\":\"token\",\"value\":\"gno\.land/r/test/token_v0\.TKV0\.0000000\"\},\{\"key\":\"from\",\"value\":\"g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5\"\},\{\"key\":\"to\",\"value\":\"g1dexaf6aqkkyr9yfy9d5up69lsn7ra80af34g5v\"\},\{\"key\":\"value\",\"value\":\"10000\"\}\],\"pkg_path\":\"gno\.land/p/nt/grc20/v0\"\}.*\{\"type\":\"Swap\",\"attrs\":\[.*\{\"key\":\"poolPath\",\"value\":\"gno\.land/r/test/token_dual_v0first\.DUAL:gno\.land/r/test/token_v0\.TKV0:3000\"\}.*\{\"key\":\"token0Amount\",\"value\":\"\-9871\"\}.*\{\"key\":\"token1Amount\",\"value\":\"10000\"\}.*\],\"pkg_path\":\"gno\.land/r/gnoswap/pool/v1\"\}.*\{\"type\":\"Transfer\",\"attrs\":\[\{\"key\":\"token\",\"value\":\"gno\.land/r/test/token_dual_v0first\.DUAL\.0000000\"\},\{\"key\":\"from\",\"value\":\"g1vc883gshu5z7ytk5cdynhc8c2dh67pdp4cszkp\"\},\{\"key\":\"to\",\"value\":\"g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5\"\},\{\"key\":\"value\",\"value\":\"9857\"\}\],\"pkg_path\":\"gno\.land/p/nt/grc20/v0\"\}.*\{\"type\":\"ExactInSwap\",\"attrs\":\[.*\{\"key\":\"resultInputAmount\",\"value\":\"10000\"\}.*\{\"key\":\"resultOutputAmount\",\"value\":\"9857\"\}.*\],\"pkg_path\":\"gno\.land/r/gnoswap/router/v1\"\}'
gnokey query vm/qeval --data "gno.land/r/test/token_dual_v0first.BalanceOfV0(\"g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5\")"
stdout '\(999009857 int64\)'
gnokey query vm/qeval --data "gno.land/r/test/token_dual_v0first.BalanceOfV1(\"g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5\")"
stdout '\(0 int64\)'

## LP withdraws all liquidity: funds come back from the v0 ledger
gnokey maketx call -pkgpath gno.land/r/gnoswap/position -func DecreaseLiquidity -args 1 -args 1000000 -args 0 -args 0 -args 9999999999 -gas-fee 100000000ugnot -gas-wanted 1000000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'
stdout '\(1 uint64\)'
stdout '\(\"1000000\" string\)'
stdout '\(\"0\" string\)'
stdout '\(\"29\" string\)'
stdout '\(\"990128\" string\)'
stdout '\(\"1009969\" string\)'
stdout 'EVENTS:     .*\{\"type\":\"Transfer\",\"attrs\":\[\{\"key\":\"token\",\"value\":\"gno\.land/r/test/token_v0\.TKV0\.0000000\"\},\{\"key\":\"from\",\"value\":\"g1dexaf6aqkkyr9yfy9d5up69lsn7ra80af34g5v\"\},\{\"key\":\"to\",\"value\":\"g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5\"\},\{\"key\":\"value\",\"value\":\"29\"\}\],\"pkg_path\":\"gno\.land/p/nt/grc20/v0\"\}.*\{\"type\":\"Transfer\",\"attrs\":\[\{\"key\":\"token\",\"value\":\"gno\.land/r/test/token_dual_v0first\.DUAL\.0000000\"\},\{\"key\":\"from\",\"value\":\"g1dexaf6aqkkyr9yfy9d5up69lsn7ra80af34g5v\"\},\{\"key\":\"to\",\"value\":\"g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5\"\},\{\"key\":\"value\",\"value\":\"990128\"\}\],\"pkg_path\":\"gno\.land/p/nt/grc20/v0\"\}.*\{\"type\":\"Transfer\",\"attrs\":\[\{\"key\":\"token\",\"value\":\"gno\.land/r/test/token_v0\.TKV0\.0000000\"\},\{\"key\":\"from\",\"value\":\"g1dexaf6aqkkyr9yfy9d5up69lsn7ra80af34g5v\"\},\{\"key\":\"to\",\"value\":\"g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5\"\},\{\"key\":\"value\",\"value\":\"1009969\"\}\],\"pkg_path\":\"gno\.land/p/nt/grc20/v0\"\}.*\{\"type\":\"DecreaseLiquidity\",\"attrs\":\[.*\{\"key\":\"lpPositionId\",\"value\":\"1\"\}.*\{\"key\":\"liquidityDelta\",\"value\":\"1000000\"\}.*\{\"key\":\"amount0\",\"value\":\"990128\"\}.*\{\"key\":\"amount1\",\"value\":\"1009969\"\}.*\],\"pkg_path\":\"gno\.land/r/gnoswap/position/v1\"\}'
gnokey query vm/qeval --data "gno.land/r/test/token_dual_v0first.BalanceOfV0(\"g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5\")"
stdout '\(999999985 int64\)'
gnokey query vm/qeval --data "gno.land/r/test/token_dual_v0first.BalanceOfV1(\"g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5\")"
stdout '\(0 int64\)'
gnokey query vm/qeval --data "gno.land/r/test/token_dual_v0first.BalanceOfV0(\"g1dexaf6aqkkyr9yfy9d5up69lsn7ra80af34g5v\")"
stdout '\(1 int64\)'
gnokey query vm/qeval --data "gno.land/r/test/token_dual_v0first.BalanceOfV1(\"g1dexaf6aqkkyr9yfy9d5up69lsn7ra80af34g5v\")"
stdout '\(0 int64\)'
gnokey query vm/qeval --data "gno.land/r/test/token_v0.BalanceOf(\"g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5\")"
stdout '\(999999998 int64\)'
gnokey query vm/qeval --data "gno.land/r/test/token_v0.BalanceOf(\"g1dexaf6aqkkyr9yfy9d5up69lsn7ra80af34g5v\")"
stdout '\(2 int64\)'

-- grc20_v1/gnomod.toml --
module = "gno.land/p/nt/grc20/v1"
gno = "0.9"
-- grc20_v1/grc20.gno --
// Mock of a second GRC20 generation. It keeps the v0 method shapes and event
// shapes but owns a completely separate ledger type, so a v1 token can never
// be handled by v0 code. Events carry this package's path, which is how the
// integration test proves which generation executed a transfer.
package grc20

import (
	"chain"
	"errors"
	"strconv"
)

const (
	NewTokenEvent = "NewToken"
	TransferEvent = "Transfer"
	ApprovalEvent = "Approval"
)

var (
	ErrInsufficientBalance   = errors.New("insufficient balance")
	ErrInsufficientAllowance = errors.New("insufficient allowance")
	ErrSpoofedRealm          = errors.New("rlm does not match the current crossing frame")
)

type Teller interface {
	GetName() string
	GetSymbol() string
	GetDecimals() int
	TotalSupply() int64
	BalanceOf(account address) int64
	Allowance(owner, spender address) int64
	Transfer(_ int, rlm realm, to address, amount int64) error
	Approve(_ int, rlm realm, spender address, amount int64) error
	TransferFrom(_ int, rlm realm, from, to address, amount int64) error
}

type Token struct {
	id       string
	name     string
	symbol   string
	decimals int
	origin   string
	ledger   *PrivateLedger
}

type PrivateLedger struct {
	token       *Token
	totalSupply int64
	balances    map[address]int64
	allowances  map[string]int64
}

func NewToken(name, symbol string, decimals int, rlm realm) (*Token, *PrivateLedger) {
	if !rlm.IsCurrent() {
		panic(ErrSpoofedRealm)
	}
	ledger := &PrivateLedger{
		balances:   make(map[address]int64),
		allowances: make(map[string]int64),
	}
	token := &Token{
		id:       rlm.PkgPath() + "." + symbol + ".v1",
		name:     name,
		symbol:   symbol,
		decimals: decimals,
		origin:   rlm.PkgPath(),
		ledger:   ledger,
	}
	ledger.token = token
	chain.Emit(
		NewTokenEvent,
		"token", token.id,
		"name", name,
		"symbol", symbol,
		"decimals", strconv.Itoa(decimals),
	)
	return token, ledger
}

func (t *Token) ID() string                          { return t.id }
func (t *Token) GetName() string                     { return t.name }
func (t *Token) GetSymbol() string                   { return t.symbol }
func (t *Token) GetDecimals() int                    { return t.decimals }
func (t *Token) Origin() string                      { return t.origin }
func (t *Token) TotalSupply() int64                  { return t.ledger.totalSupply }
func (t *Token) BalanceOf(account address) int64     { return t.ledger.balances[account] }
func (t *Token) Allowance(owner, spender address) int64 {
	return t.ledger.allowances[allowanceKey(owner, spender)]
}

func (t *Token) RealmTeller(_ int, rlm realm) Teller {
	if !rlm.IsCurrent() {
		panic(ErrSpoofedRealm)
	}
	return &realmTeller{Token: t, actor: rlm.Address()}
}

// CallerTeller returns a teller whose actor is the caller of the current
// crossing frame (the user or realm that invoked the token realm).
func (l *PrivateLedger) CallerTeller() Teller {
	return &callerTeller{Token: l.token}
}

func (l *PrivateLedger) Mint(to address, amount int64) error {
	l.balances[to] += amount
	l.totalSupply += amount
	l.emitTransfer("", to, amount)
	return nil
}

func (l *PrivateLedger) transfer(from, to address, amount int64) error {
	if l.balances[from] < amount {
		return ErrInsufficientBalance
	}
	l.balances[from] -= amount
	l.balances[to] += amount
	l.emitTransfer(from, to, amount)
	return nil
}

func (l *PrivateLedger) emitTransfer(from, to address, amount int64) {
	chain.Emit(
		TransferEvent,
		"token", l.token.id,
		"from", string(from),
		"to", string(to),
		"value", strconv.Itoa(int(amount)),
	)
}

type realmTeller struct {
	*Token
	actor address
}

func (rt *realmTeller) Transfer(_ int, rlm realm, to address, amount int64) error {
	if !rlm.IsCurrent() {
		return ErrSpoofedRealm
	}
	return rt.ledger.transfer(rt.actor, to, amount)
}

func (rt *realmTeller) Approve(_ int, rlm realm, spender address, amount int64) error {
	if !rlm.IsCurrent() {
		return ErrSpoofedRealm
	}
	rt.ledger.allowances[allowanceKey(rt.actor, spender)] = amount
	chain.Emit(
		ApprovalEvent,
		"token", rt.id,
		"owner", string(rt.actor),
		"spender", string(spender),
		"value", strconv.Itoa(int(amount)),
	)
	return nil
}

func (rt *realmTeller) TransferFrom(_ int, rlm realm, from, to address, amount int64) error {
	if !rlm.IsCurrent() {
		return ErrSpoofedRealm
	}
	key := allowanceKey(from, rt.actor)
	if rt.ledger.allowances[key] < amount {
		return ErrInsufficientAllowance
	}
	if err := rt.ledger.transfer(from, to, amount); err != nil {
		return err
	}
	rt.ledger.allowances[key] -= amount
	return nil
}

type callerTeller struct {
	*Token
}

func (ct *callerTeller) actor(_ int, rlm realm) address {
	if !rlm.IsCurrent() {
		panic(ErrSpoofedRealm)
	}
	return rlm.Previous().Address()
}

func (ct *callerTeller) Transfer(_ int, rlm realm, to address, amount int64) error {
	return ct.ledger.transfer(ct.actor(0, rlm), to, amount)
}

func (ct *callerTeller) Approve(_ int, rlm realm, spender address, amount int64) error {
	owner := ct.actor(0, rlm)
	ct.ledger.allowances[allowanceKey(owner, spender)] = amount
	chain.Emit(
		ApprovalEvent,
		"token", ct.id,
		"owner", string(owner),
		"spender", string(spender),
		"value", strconv.Itoa(int(amount)),
	)
	return nil
}

func (ct *callerTeller) TransferFrom(_ int, rlm realm, from, to address, amount int64) error {
	spender := ct.actor(0, rlm)
	key := allowanceKey(from, spender)
	if ct.ledger.allowances[key] < amount {
		return ErrInsufficientAllowance
	}
	if err := ct.ledger.transfer(from, to, amount); err != nil {
		return err
	}
	ct.ledger.allowances[key] -= amount
	return nil
}

func allowanceKey(owner, spender address) string {
	return string(owner) + ":" + string(spender)
}
-- grc20reg_v1/gnomod.toml --
module = "gno.land/r/nt/grc20reg/v1"
gno = "0.9"
-- grc20reg_v1/grc20reg.gno --
// Mock registry for the second GRC20 generation. Keys use the same
// "<realm path>.<SYMBOL>" shape as grc20reg/v0.
package grc20reg

import (
	"chain"

	"gno.land/p/nt/grc20/v1"
)

const registerEvent = "register"

var registry = make(map[string]*grc20.Token)

func Register(cur realm, token *grc20.Token) string {
	if token == nil {
		panic("grc20reg: nil token")
	}
	rlmPath := cur.Previous().PkgPath()
	if token.Origin() != rlmPath {
		panic("grc20reg: token must be registered from its own realm")
	}
	key := rlmPath + "." + token.GetSymbol()
	if _, ok := registry[key]; ok {
		panic("grc20reg: token already registered")
	}
	registry[key] = token
	chain.Emit(
		registerEvent,
		"token_path", key,
		"pkgpath", rlmPath,
		"symbol", token.GetSymbol(),
	)
	return key
}

func Get(key string) *grc20.Token {
	return registry[key]
}
-- token_v0/gnomod.toml --
module = "gno.land/r/test/token_v0"
gno = "0.9"
-- token_v0/token.gno --
package token_v0

import (
	"chain"

	"gno.land/p/nt/grc20/v0"
	"gno.land/r/nt/grc20reg/v0"
)

const admin = address("g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5")

var (
	token         *grc20.Token
	privateLedger *grc20.PrivateLedger
	userTeller    grc20.Teller
)

func init(cur realm) {
	token, privateLedger = grc20.NewToken("TokenV0", "TKV0", 6, 0, cur)
	userTeller = privateLedger.CallerTeller()
	privateLedger.Mint(chain.PackageAddress("gno.land/r/test/common_caller"), 1_000_000)
	privateLedger.Mint(admin, 1_000_000_000)
	grc20reg.Register(cross(cur), token, "")
}

func TotalSupply() int64 {
	return token.TotalSupply()
}

func BalanceOf(owner address) int64 {
	return token.BalanceOf(owner)
}

func Allowance(owner, spender address) int64 {
	return token.Allowance(owner, spender)
}

func Approve(cur realm, spender address, amount int64) {
	checkErr(userTeller.Approve(0, cur, spender, amount))
}

func Transfer(cur realm, to address, amount int64) {
	checkErr(userTeller.Transfer(0, cur, to, amount))
}

func checkErr(err error) {
	if err != nil {
		panic(err.Error())
	}
}
-- common_caller/caller.gno --
// Stand-in for a core realm: every token operation goes through common with
// this realm as the token actor.
package common_caller

import (
	"gno.land/r/gnoswap/common"
)

func Transfer(cur realm, tokenKey string, to address, amount int64) {
	common.SafeGRC20Transfer(0, cur, tokenKey, to, amount)
}

func TransferFrom(cur realm, tokenKey string, from, to address, amount int64) {
	common.SafeGRC20TransferFrom(0, cur, tokenKey, from, to, amount)
}

func Approve(cur realm, tokenKey string, spender address, amount int64) {
	common.SafeGRC20Approve(0, cur, tokenKey, spender, amount)
}

func IsRegistered(tokenKey string) bool {
	return common.IsRegistered(tokenKey) == nil
}
