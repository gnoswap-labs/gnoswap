gnokey maketx call -pkgpath gno.land/r/test/common_caller -func Approve -args "gno.land/r/test/token_v0.TKV0" -args $test1_user_addr -args 7 -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'
stdout 'EVENTS:     \[\{\"type\":\"Approval\",\"attrs\":\[\{\"key\":\"token\",\"value\":\"gno\.land/r/test/token_v0\.TKV0\.0000000\"\},\{\"key\":\"owner\",\"value\":\"g1u97mvf4yjxf5anvum8pfzp9w3aa3c7upyfta2r\"\},\{\"key\":\"spender\",\"value\":\"g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5\"\},\{\"key\":\"value\",\"value\":\"7\"\}\],\"pkg_path\":\"gno\.land/p/nt/grc20/v0\"\}'
gnokey query vm/qeval --data "gno.land/r/gnoswap/common.Allowance(\"gno.land/r/test/token_v0.TKV0\", \"g1u97mvf4yjxf5anvum8pfzp9w3aa3c7upyfta2r\", \"g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5\")"
stdout '\(7 int64\)'

## v0: balance exceeded on Transfer
! gnokey maketx call -pkgpath gno.land/r/test/common_caller -func Transfer -args "gno.land/r/test/token_v0.TKV0" -args "g1dexaf6aqkkyr9yfy9d5up69lsn7ra80af34g5v" -args 2000000 -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
