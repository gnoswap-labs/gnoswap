func init(cur realm) {
	tokenV1, ledgerV1 = grc20v1.NewToken("Dual", "DUAL", 6, cur)
	ledgerV1.Mint(chain.PackageAddress("gno.land/r/test/common_caller"), 1_000_000)
	grc20regv1.Register(cross(cur), tokenV1)
}

func RegisterV0(cur realm) {
	tokenV0, ledgerV0 = grc20v0.NewToken("Dual", "DUAL", 6, 0, cur)
	ledgerV0.Mint(chain.PackageAddress("gno.land/r/test/common_caller"), 1_000_000)
	grc20regv0.Register(cross(cur), tokenV0, "")
}

