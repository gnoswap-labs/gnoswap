stdout '\(true bool\)'
gnokey query vm/qeval --data "gno.land/r/test/token_dual_v1first.BalanceOfV0(\"g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5\")"
stdout '\(0 int64\)'

## v0 priority now routes this key to the v0 ledger; the v1 balance stays frozen at 10
gnokey maketx call -pkgpath gno.land/r/test/common_caller -func Transfer -args "gno.land/r/test/token_dual_v1first.DUAL" -args $test1_user_addr -args 20 -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'
stdout 'EVENTS:     \[\{\"type\":\"Transfer\",\"attrs\":\[\{\"key\":\"token\",\"value\":\"gno\.land/r/test/token_dual_v1first\.DUAL\.0000000\"\},\{\"key\":\"from\",\"value\":\"g1u97mvf4yjxf5anvum8pfzp9w3aa3c7upyfta2r\"\},\{\"key\":\"to\",\"value\":\"g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5\"\},\{\"key\":\"value\",\"value\":\"20\"\}\],\"pkg_path\":\"gno\.land/p/nt/grc20/v0\"\}'
gnokey query vm/qeval --data "gno.land/r/test/token_dual_v1first.BalanceOfV0(\"g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5\")"
stdout '\(20 int64\)'
gnokey query vm/qeval --data "gno.land/r/test/token_dual_v1first.BalanceOfV1(\"g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5\")"
stdout '\(10 int64\)'
gnokey query vm/qeval --data "gno.land/r/gnoswap/common.BalanceOf(\"gno.land/r/test/token_dual_v1first.DUAL\", \"g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5\")"
stdout '\(20 int64\)'
