# Verifies how common/v2 resolves a token key that exists in BOTH GRC20
# registry generations (grc20reg/v0 and grc20reg/v1).
#
# common/v2 gives v0 priority: a key present in grc20reg/v0 is always served
# from the v0 ledger, whichever generation was registered first. Events prove
# which generation executed every mint and transfer.
#
# Case A: v0 registered at deploy, v1 added later  -> v0 before and after.
# Case B: v1 registered at deploy, v0 added later  -> v1 first, then v0.

loadpkg gno.land/p/nt/bptree/v0
loadpkg gno.land/p/nt/ufmt/v0
loadpkg gno.land/p/onbloc/json/v0
loadpkg gno.land/p/nt/ownable/v0
loadpkg gno.land/p/nt/grc20/v0

loadpkg gno.land/r/sys/users
loadpkg gno.land/r/nt/grc20reg/v0

loadpkg gno.land/p/gnoswap/uint256/v1
loadpkg gno.land/p/gnoswap/int256/v1
loadpkg gno.land/p/gnoswap/consts/v1
loadpkg gno.land/p/gnoswap/gnsmath
loadpkg gno.land/p/gnoswap/store
loadpkg gno.land/p/gnoswap/version_manager
loadpkg gno.land/p/gnoswap/utils/v1

loadpkg gno.land/r/gnoswap/access
loadpkg gno.land/r/gnoswap/rbac
loadpkg gno.land/r/gnoswap/common
loadpkg gno.land/r/gnoswap/common/v1

gnoland start

gnokey maketx send -send 15000000000ugnot -to $test1_user_addr -broadcast -chainid=tendermint_test -gas-fee 100000000ugnot -gas-wanted 100000000 test1

## Deploy the second GRC20 generation (mock) and the calling realm
gnokey maketx addpkg -pkgdir $WORK/grc20_v1 -pkgpath gno.land/p/nt/grc20/v1 -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
gnokey maketx addpkg -pkgdir $WORK/grc20reg_v1 -pkgpath gno.land/r/nt/grc20reg/v1 -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
gnokey maketx addpkg -pkgdir $WORK/common_caller -pkgpath gno.land/r/test/common_caller -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1

## Register and activate common/v2 (v0 has priority over v1)
gnokey maketx addpkg -pkgdir $WORK/common_v2 -pkgpath gno.land/r/gnoswap/common/v2 -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout 'EVENTS:     \[\{\"type\":\"RegisterInitializer\",\"attrs\":\[\{\"key\":\"domainPath\",\"value\":\"gno\.land/r/gnoswap/common\"\},\{\"key\":\"registeredPackagePath\",\"value\":\"gno\.land/r/gnoswap/common/v2\"\}\],\"pkg_path\":\"gno\.land/p/gnoswap/version_manager\"\}'
gnokey maketx call -pkgpath gno.land/r/gnoswap/common -func UpgradeImpl -args "gno.land/r/gnoswap/common/v2" -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'
stdout 'EVENTS:     \[\{\"type\":\"ChangeImplementation\",\"attrs\":\[\{\"key\":\"domainPath\",\"value\":\"gno\.land/r/gnoswap/common\"\},\{\"key\":\"previousPackagePath\",\"value\":\"gno\.land/r/gnoswap/common/v1\"\},\{\"key\":\"newPackagePath\",\"value\":\"gno\.land/r/gnoswap/common/v2\"\}\],\"pkg_path\":\"gno\.land/p/gnoswap/version_manager\"\}'
gnokey query vm/qeval --data "gno.land/r/gnoswap/common.GetImplementationPackagePath()"
stdout '\(\"gno.land/r/gnoswap/common/v2\" string\)'


## Case A: v0 registered first, v1 added later under the same key
gnokey maketx addpkg -pkgdir $WORK/token_dual_v0first -pkgpath gno.land/r/test/token_dual_v0first -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout 'EVENTS:     \[\{\"type\":\"NewToken\",\"attrs\":\[\{\"key\":\"token\",\"value\":\"gno\.land/r/test/token_dual_v0first\.DUAL\.0000000\"\},\{\"key\":\"name\",\"value\":\"Dual\"\},\{\"key\":\"symbol\",\"value\":\"DUAL\"\},\{\"key\":\"decimals\",\"value\":\"6\"\}\],\"pkg_path\":\"gno\.land/p/nt/grc20/v0\"\},\{\"type\":\"Transfer\",\"attrs\":\[\{\"key\":\"token\",\"value\":\"gno\.land/r/test/token_dual_v0first\.DUAL\.0000000\"\},\{\"key\":\"from\",\"value\":\"\"\},\{\"key\":\"to\",\"value\":\"g1u97mvf4yjxf5anvum8pfzp9w3aa3c7upyfta2r\"\},\{\"key\":\"value\",\"value\":\"1000000\"\}\],\"pkg_path\":\"gno\.land/p/nt/grc20/v0\"\},\{\"type\":\"Transfer\",\"attrs\":\[\{\"key\":\"token\",\"value\":\"gno\.land/r/test/token_dual_v0first\.DUAL\.0000000\"\},\{\"key\":\"from\",\"value\":\"\"\},\{\"key\":\"to\",\"value\":\"g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5\"\},\{\"key\":\"value\",\"value\":\"1000000000\"\}\],\"pkg_path\":\"gno\.land/p/nt/grc20/v0\"\},\{\"type\":\"register\",\"attrs\":\[\{\"key\":\"token_path\",\"value\":\"gno\.land/r/test/token_dual_v0first\.DUAL\"\},\{\"key\":\"pkgpath\",\"value\":\"gno\.land/r/test/token_dual_v0first\"\},\{\"key\":\"slug\",\"value\":\"\"\},\{\"key\":\"symbol\",\"value\":\"DUAL\"\}\],\"pkg_path\":\"gno\.land/r/nt/grc20reg/v0\"\}'
gnokey query vm/qeval --data "gno.land/r/test/common_caller.IsRegistered(\"gno.land/r/test/token_dual_v0first.DUAL\")"
stdout '\(true bool\)'
gnokey query vm/qeval --data "gno.land/r/test/token_dual_v0first.BalanceOfV1(\"g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5\")"
stdout '\(-1 int64\)'

## Only v0 exists: transfer executes on the v0 ledger
gnokey maketx call -pkgpath gno.land/r/test/common_caller -func Transfer -args "gno.land/r/test/token_dual_v0first.DUAL" -args $test1_user_addr -args 10 -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'
stdout 'EVENTS:     \[\{\"type\":\"Transfer\",\"attrs\":\[\{\"key\":\"token\",\"value\":\"gno\.land/r/test/token_dual_v0first\.DUAL\.0000000\"\},\{\"key\":\"from\",\"value\":\"g1u97mvf4yjxf5anvum8pfzp9w3aa3c7upyfta2r\"\},\{\"key\":\"to\",\"value\":\"g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5\"\},\{\"key\":\"value\",\"value\":\"10\"\}\],\"pkg_path\":\"gno\.land/p/nt/grc20/v0\"\}'
gnokey query vm/qeval --data "gno.land/r/test/token_dual_v0first.BalanceOfV0(\"g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5\")"
stdout '\(1000000010 int64\)'

## Issuer registers a v1 token under the very same key
gnokey maketx call -pkgpath gno.land/r/test/token_dual_v0first -func RegisterV1  -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'
stdout 'EVENTS:     \[\{\"type\":\"NewToken\",\"attrs\":\[\{\"key\":\"token\",\"value\":\"gno\.land/r/test/token_dual_v0first\.DUAL\.v1\"\},\{\"key\":\"name\",\"value\":\"Dual\"\},\{\"key\":\"symbol\",\"value\":\"DUAL\"\},\{\"key\":\"decimals\",\"value\":\"6\"\}\],\"pkg_path\":\"gno\.land/p/nt/grc20/v1\"\},\{\"type\":\"Transfer\",\"attrs\":\[\{\"key\":\"token\",\"value\":\"gno\.land/r/test/token_dual_v0first\.DUAL\.v1\"\},\{\"key\":\"from\",\"value\":\"\"\},\{\"key\":\"to\",\"value\":\"g1u97mvf4yjxf5anvum8pfzp9w3aa3c7upyfta2r\"\},\{\"key\":\"value\",\"value\":\"1000000\"\}\],\"pkg_path\":\"gno\.land/p/nt/grc20/v1\"\},\{\"type\":\"register\",\"attrs\":\[\{\"key\":\"token_path\",\"value\":\"gno\.land/r/test/token_dual_v0first\.DUAL\"\},\{\"key\":\"pkgpath\",\"value\":\"gno\.land/r/test/token_dual_v0first\"\},\{\"key\":\"symbol\",\"value\":\"DUAL\"\}\],\"pkg_path\":\"gno\.land/r/nt/grc20reg/v1\"\}'
gnokey query vm/qeval --data "gno.land/r/test/common_caller.IsRegistered(\"gno.land/r/test/token_dual_v0first.DUAL\")"
stdout '\(true bool\)'
gnokey query vm/qeval --data "gno.land/r/test/token_dual_v0first.BalanceOfV1(\"g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5\")"
stdout '\(0 int64\)'

## v0 keeps priority: transfer still executes on the v0 ledger, v1 untouched
gnokey maketx call -pkgpath gno.land/r/test/common_caller -func Transfer -args "gno.land/r/test/token_dual_v0first.DUAL" -args $test1_user_addr -args 20 -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'
stdout 'EVENTS:     \[\{\"type\":\"Transfer\",\"attrs\":\[\{\"key\":\"token\",\"value\":\"gno\.land/r/test/token_dual_v0first\.DUAL\.0000000\"\},\{\"key\":\"from\",\"value\":\"g1u97mvf4yjxf5anvum8pfzp9w3aa3c7upyfta2r\"\},\{\"key\":\"to\",\"value\":\"g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5\"\},\{\"key\":\"value\",\"value\":\"20\"\}\],\"pkg_path\":\"gno\.land/p/nt/grc20/v0\"\}'
gnokey query vm/qeval --data "gno.land/r/test/token_dual_v0first.BalanceOfV0(\"g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5\")"
stdout '\(1000000030 int64\)'
gnokey query vm/qeval --data "gno.land/r/test/token_dual_v0first.BalanceOfV1(\"g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5\")"
stdout '\(0 int64\)'
gnokey query vm/qeval --data "gno.land/r/gnoswap/common.BalanceOf(\"gno.land/r/test/token_dual_v0first.DUAL\", \"g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5\")"
stdout '\(1000000030 int64\)'
gnokey query vm/qeval --data "gno.land/r/gnoswap/common.TotalSupply(\"gno.land/r/test/token_dual_v0first.DUAL\")"
stdout '\(1001000000 int64\)'

## Case B: v1 registered first, v0 added later under the same key
gnokey maketx addpkg -pkgdir $WORK/token_dual_v1first -pkgpath gno.land/r/test/token_dual_v1first -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout 'EVENTS:     \[\{\"type\":\"NewToken\",\"attrs\":\[\{\"key\":\"token\",\"value\":\"gno\.land/r/test/token_dual_v1first\.DUAL\.v1\"\},\{\"key\":\"name\",\"value\":\"Dual\"\},\{\"key\":\"symbol\",\"value\":\"DUAL\"\},\{\"key\":\"decimals\",\"value\":\"6\"\}\],\"pkg_path\":\"gno\.land/p/nt/grc20/v1\"\},\{\"type\":\"Transfer\",\"attrs\":\[\{\"key\":\"token\",\"value\":\"gno\.land/r/test/token_dual_v1first\.DUAL\.v1\"\},\{\"key\":\"from\",\"value\":\"\"\},\{\"key\":\"to\",\"value\":\"g1u97mvf4yjxf5anvum8pfzp9w3aa3c7upyfta2r\"\},\{\"key\":\"value\",\"value\":\"1000000\"\}\],\"pkg_path\":\"gno\.land/p/nt/grc20/v1\"\},\{\"type\":\"register\",\"attrs\":\[\{\"key\":\"token_path\",\"value\":\"gno\.land/r/test/token_dual_v1first\.DUAL\"\},\{\"key\":\"pkgpath\",\"value\":\"gno\.land/r/test/token_dual_v1first\"\},\{\"key\":\"symbol\",\"value\":\"DUAL\"\}\],\"pkg_path\":\"gno\.land/r/nt/grc20reg/v1\"\}'
gnokey query vm/qeval --data "gno.land/r/test/common_caller.IsRegistered(\"gno.land/r/test/token_dual_v1first.DUAL\")"
stdout '\(true bool\)'
gnokey query vm/qeval --data "gno.land/r/test/token_dual_v1first.BalanceOfV0(\"g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5\")"
stdout '\(-1 int64\)'

## Only v1 exists: transfer executes on the v1 ledger
gnokey maketx call -pkgpath gno.land/r/test/common_caller -func Transfer -args "gno.land/r/test/token_dual_v1first.DUAL" -args $test1_user_addr -args 10 -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'
stdout 'EVENTS:     \[\{\"type\":\"Transfer\",\"attrs\":\[\{\"key\":\"token\",\"value\":\"gno\.land/r/test/token_dual_v1first\.DUAL\.v1\"\},\{\"key\":\"from\",\"value\":\"g1u97mvf4yjxf5anvum8pfzp9w3aa3c7upyfta2r\"\},\{\"key\":\"to\",\"value\":\"g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5\"\},\{\"key\":\"value\",\"value\":\"10\"\}\],\"pkg_path\":\"gno\.land/p/nt/grc20/v1\"\}'
gnokey query vm/qeval --data "gno.land/r/test/token_dual_v1first.BalanceOfV1(\"g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5\")"
stdout '\(10 int64\)'
gnokey query vm/qeval --data "gno.land/r/gnoswap/common.TotalSupply(\"gno.land/r/test/token_dual_v1first.DUAL\")"
stdout '\(1000000 int64\)'

## Issuer registers a v0 token under the very same key
gnokey maketx call -pkgpath gno.land/r/test/token_dual_v1first -func RegisterV0  -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'
stdout 'EVENTS:     \[\{\"type\":\"NewToken\",\"attrs\":\[\{\"key\":\"token\",\"value\":\"gno\.land/r/test/token_dual_v1first\.DUAL\.0000000\"\},\{\"key\":\"name\",\"value\":\"Dual\"\},\{\"key\":\"symbol\",\"value\":\"DUAL\"\},\{\"key\":\"decimals\",\"value\":\"6\"\}\],\"pkg_path\":\"gno\.land/p/nt/grc20/v0\"\},\{\"type\":\"Transfer\",\"attrs\":\[\{\"key\":\"token\",\"value\":\"gno\.land/r/test/token_dual_v1first\.DUAL\.0000000\"\},\{\"key\":\"from\",\"value\":\"\"\},\{\"key\":\"to\",\"value\":\"g1u97mvf4yjxf5anvum8pfzp9w3aa3c7upyfta2r\"\},\{\"key\":\"value\",\"value\":\"1000000\"\}\],\"pkg_path\":\"gno\.land/p/nt/grc20/v0\"\},\{\"type\":\"register\",\"attrs\":\[\{\"key\":\"token_path\",\"value\":\"gno\.land/r/test/token_dual_v1first\.DUAL\"\},\{\"key\":\"pkgpath\",\"value\":\"gno\.land/r/test/token_dual_v1first\"\},\{\"key\":\"slug\",\"value\":\"\"\},\{\"key\":\"symbol\",\"value\":\"DUAL\"\}\],\"pkg_path\":\"gno\.land/r/nt/grc20reg/v0\"\}'
