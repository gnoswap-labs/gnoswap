{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":approveMajorUpdates"
  ],
  "automerge": false,
  "prConcurrentLimit": 3,
  "addLabels": [
    "renovate"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "action"
      ],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "separateMajorMinor": true
    }
  ]
}
